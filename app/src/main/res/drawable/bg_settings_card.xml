<?xml version="1.0" encoding="utf-8"?>
<!-- 深色模式设置卡片：渐变整体提亮，与页面背景 #08090B 拉开层次，卡片轮廓与文字对比更清晰 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="112"
                android:startColor="#995E636C" android:centerColor="#A0293038"
                android:endColor="#AA14181C" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_25" />
        </shape>
    </item>
</layer-list>
