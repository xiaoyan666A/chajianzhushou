<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_25" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/accent_40" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_08" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/accent_15" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_15" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/accent_25" />
        </shape>
    </item>
</selector>
