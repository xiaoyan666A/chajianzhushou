<?xml version="1.0" encoding="utf-8"?>
<!-- 超时件卡片（浅色主题）：黄色边框 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="112"
                android:startColor="#F8FFFFFF" android:centerColor="#F2FFFFFF"
                android:endColor="#EBFFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/warning" />
        </shape>
    </item>
</layer-list>
