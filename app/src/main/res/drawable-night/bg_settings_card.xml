<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色模式设置卡片：接近纯白渐变，与页面背景 #EEF2F6 形成清晰层次，深色文字对比显著提升 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="112"
                android:startColor="#FFFFFFFF" android:centerColor="#FFFFFFFF"
                android:endColor="#FFFAFCFE" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_30" />
        </shape>
    </item>
</layer-list>
