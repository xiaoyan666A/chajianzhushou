<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chajianzhushou" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 统一所有 AlertDialog 使用 App 风格对话框主题 -->
        <item name="alertDialogTheme">@style/Theme.Chajianzhushou.Dialog</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">#FF00C4A7</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">#FF00C4A7</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card_solid</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">#FF101216</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- 管理员验证等对话框主题（深色=values/） -->
    <style name="Theme.Chajianzhushou.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card_solid</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="colorControlNormal">@color/ink2</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/accent_12</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
